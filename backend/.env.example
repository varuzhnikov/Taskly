# Copy this file to .env and fill in the values.
# Never commit .env to version control.

PORT=8080
ENV=development

DATABASE_URL=postgres://todoist:todoist@localhost:5432/todoist?sslmode=disable

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-random-32-byte-hex-string

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# Optional. Comma-separated list of exact origins for browser access to the API.
# When omitted in development, the backend accepts http://localhost:* and http://127.0.0.1:*.
# Example:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
