# URL of the Go backend (server-side only, used in Route Handlers)
BACKEND_URL=http://localhost:8080

# Optional browser-side API override.
# When unset, or when it points to localhost/127.0.0.1, the frontend uses
# the same-origin /api/backend proxy to avoid browser CORS issues in local dev.
# NEXT_PUBLIC_API_URL=https://api.example.com

# E2E test credentials (optional, skips auth-dependent tests if unset)
# E2E_USER_EMAIL=test@example.com
# E2E_USER_PASSWORD=testpassword
